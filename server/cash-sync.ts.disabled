// Real-time Cash Management Synchronization System
// Professional Accounting Principles Implementation

import { ACCOUNT_TYPES } from '../shared/constants.js';

// Real-time cash sync functions

export interface CashSyncEngine {
  syncLoanDisbursement(loanId: string, tenantId: string): Promise<void>;
  syncLoanClosure(loanId: string, closureData: any, tenantId: string): Promise<void>;
  syncLoanReopen(loanId: string, tenantId: string): Promise<void>;
  syncCashTransaction(transactionId: string, tenantId: string): Promise<void>;
  handleLoanDelete(loanId: string, tenantId: string): Promise<void>;
  handleCashTransactionDelete(transactionId: string, tenantId: string): Promise<void>;
  validateCashBalance(tenantId: string): Promise<boolean>;
  generateAccountingSummary(tenantId: string, dateFrom: string, dateTo: string): Promise<any>;
}

// Export individual functions for modular use

export function createCashSyncEngine(storage: any): CashSyncEngine {
  
  // Helper function to format date consistently
  const formatDateForDB = (dateStr: string) => {
    const date = new Date(dateStr);
    const day = date.getDate().toString().padStart(2, '0');
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const year = date.getFullYear();
    return `${day}/${month}/${year}`;
  };

  const syncLoanDisbursement = async (loanId: string, tenantId: string) => {
    try {
      const loans = await storage.getLoans(tenantId);
      const loan = loans.find((l: any) => l.id === loanId);
      
      if (!loan) {
        console.error(`Loan ${loanId} not found for cash sync`);
        return;
      }

      // ENHANCED COMPREHENSIVE PRECAUTIONS: Advanced multi-pattern duplicate prevention
      const cashTransactions = await storage.getCashTransactions(tenantId);
      const disbursementDate = formatDateForDB(loan.loanDate);
      const expectedAmount = Number(loan.principalAmount);
      const accountPattern = `खाते क्र. ${loan.accountNumber}`;
      const borrowerPattern = loan.borrowerName;
      const groupPattern = `${loan.groupName || ''}`;
      
      // PRECAUTION 1: Check for existing cash transactions with exact parameters
      const existingCashTx = cashTransactions.find((ct: any) => {
        const amountMatch = Math.abs(ct.amount - expectedAmount) < 0.01;
        const dateMatch = ct.transactionDate === disbursementDate;
        const typeMatch = ct.transactionType === 'cash_out';
        
        if (!amountMatch || !dateMatch || !typeMatch) return false;
        
        // Multiple verification patterns for maximum security
        const patterns = [
          // Pattern 1: Exact loan ID match (highest priority)
          ct.loanId === loan.id,
          // Pattern 2: Account number + disbursement keywords
          ct.narration?.includes(accountPattern) && (
            ct.narration?.includes('कर्ज वितरण') || 
            ct.narration?.includes('कर्ज दिले') ||
            ct.narration?.includes('loan disbursement')
          ),
          // Pattern 3: Borrower name + amount + disbursement
          ct.narration?.includes(borrowerPattern) && 
          ct.narration?.includes('कर्ज') &&
          (ct.narration?.includes('वितरण') || ct.narration?.includes('दिले')),
          // Pattern 4: Group + account + amount pattern
          groupPattern && ct.narration?.includes(groupPattern) && 
          ct.narration?.includes(accountPattern),
          // Pattern 5: Exact principal amount in narration
          ct.narration?.includes(`₹${expectedAmount.toLocaleString('en-IN')}`) &&
          ct.narration?.includes('मुद्दल')
        ];
        
        return patterns.some(pattern => pattern);
      });

      if (existingCashTx) {
        console.log(`🚫 COMPREHENSIVE PRECAUTION: Disbursement duplicate prevented for loan ${loan.accountNumber}:`, {
          existingId: existingCashTx.id,
          existingAmount: existingCashTx.amount,
          existingDate: existingCashTx.transactionDate,
          existingNarration: existingCashTx.narration,
          preventionType: 'multi-pattern-verification',
          securityLevel: 'maximum'
        });
        return;
      }

      // PRECAUTION 2: Additional validation checks before creating transaction
      if (!loan.principalAmount || loan.principalAmount <= 0) {
        console.error(`❌ PRECAUTION FAILED: Invalid loan amount for ${loan.accountNumber}:`, {
          principalAmount: loan.principalAmount,
          loanId: loan.id
        });
        return;
      }

      if (!loan.loanDate || new Date(loan.loanDate) > new Date()) {
        console.error(`❌ PRECAUTION FAILED: Invalid loan date for ${loan.accountNumber}:`, {
          loanDate: loan.loanDate,
          loanId: loan.id
        });
        return;
      }

      if (Number(loan.principalAmount) > 0) {
        // Get group info for narration
        const groups = await storage.getGroups(tenantId);
        const group = groups.find((g: any) => g.id === loan.groupId);
        const groupDisplayName = group ? group.name.replace(/\s*(ग्रुप|Group)$/i, '') : null;
        
        // Create disbursement cash transaction with proper loan ID linking
        const cashTransactionData = {
          tenantId: tenantId,
          transactionDate: disbursementDate,
          transactionType: 'cash_out',
          amount: expectedAmount,
          category: 'expense',
          // PRECAUTION 3: Clean, standardized narration format with comprehensive info
          narration: `कर्ज वितरण - खाते क्र. ${loan.accountNumber} ${loan.borrowerName?.trim()}${groupDisplayName ? ` (${groupDisplayName.trim()})` : ''} - मुद्दल: ₹${expectedAmount.toLocaleString('en-IN')} - ${disbursementDate}`,
          partyId: null,
          fromAccount: ACCOUNT_TYPES.CASH,
          toAccount: ACCOUNT_TYPES.CUSTOMER
        };
        
        await storage.createCashTransaction(cashTransactionData);
        
        console.log(`✅ CASH SYNC: Disbursement cash transaction created for loan ${loan.accountNumber}:`, {
          amount: expectedAmount,
          date: disbursementDate,
          loanId: loan.id
        });
      }
    } catch (error) {
      console.error(`Failed to sync loan disbursement ${loanId}:`, error);
    }
  };

  const syncLoanClosure = async (loanId: string, closureData: any, tenantId: string) => {
    try {
      const loans = await storage.getLoans(tenantId);
      const loan = loans.find((l: any) => l.id === loanId);
      
      if (!loan) {
        console.error(`Loan ${loanId} not found for closure sync`);
        return;
      }

      // DUPLICATE PREVENTION: Check if cash transaction already exists
      const existingCashTransactions = await storage.getCashTransactions(tenantId);
      const closureDate = formatDateForDB(closureData.closureDate);
      
      // CRITICAL FIX: Always use totalAmount for cash transactions (principal + interest)
      // actualPaidAmount contains only partial payment, totalAmount contains full closure amount
      const principalAmount = Number(closureData.principalPaid || 0);
      const interestAmount = Number(closureData.interestPaid || 0); 
      const expectedAmount = principalAmount + interestAmount; // Direct calculation
      
      // Optimized: Remove excessive logging in production
      
      // COMPREHENSIVE PRECAUTIONS: Advanced multi-pattern closure duplicate detection
      const accountPattern = `खाते क्र. ${loan.accountNumber}`;
      const borrowerPattern = loan.borrowerName?.trim();
      const groupPattern = loan.groupName || '';
      
      const duplicateTransaction = existingCashTransactions.find((ct: any) => {
        const amountMatch = Math.abs(ct.amount - expectedAmount) < 0.01;
        const dateMatch = ct.transactionDate === closureDate;
        const typeMatch = ct.transactionType === 'cash_in';
        
        if (!amountMatch || !dateMatch || !typeMatch) return false;
        
        // Multiple verification patterns for maximum closure security
        const closurePatterns = [
          // Pattern 1: Exact loan ID match (highest priority)
          ct.loanId === loan.id,
          // Pattern 2: Account number + closure keywords
          ct.narration?.includes(accountPattern) && (
            ct.narration?.includes('कर्ज बंद') || 
            ct.narration?.includes('कर्ज जमा') ||
            ct.narration?.includes('loan closure')
          ),
          // Pattern 3: Borrower name + closure keywords
          borrowerPattern && ct.narration?.includes(borrowerPattern) && (
            ct.narration?.includes('कर्ज बंद') || 
            ct.narration?.includes('कर्ज जमा')
          ),
          // Pattern 4: Group + account + closure pattern
          groupPattern && ct.narration?.includes(groupPattern) && 
          ct.narration?.includes(accountPattern) &&
          ct.narration?.includes('कर्ज'),
          // Pattern 5: Principal + interest amount pattern
          ct.narration?.includes(`मुद्दल: ₹${principalAmount.toLocaleString('en-IN')}`) &&
          ct.narration?.includes(`व्याज: ₹${interestAmount.toLocaleString('en-IN')}`)
        ];
        
        return closurePatterns.some(pattern => pattern);
      });
      
      if (!duplicateTransaction) {
        // PRECAUTION 4: Additional validation for closure data
        if (expectedAmount <= 0) {
          console.error(`❌ Invalid closure amount for ${loan.accountNumber}: ₹${expectedAmount}`);
          return;
        }

        if (!closureData.closureDate || new Date(closureData.closureDate) > new Date()) {
          console.error(`❌ Invalid closure date for ${loan.accountNumber}: ${closureData.closureDate}`);
          return;
        }

        // Create closure cash transaction with enhanced narration
        const groups = await storage.getGroups(tenantId);
        const group = groups.find((g: any) => g.id === loan.groupId);
        
        const groupDisplayName = group ? group.name.replace(/\s*(ग्रुप|Group)$/i, '').trim() : null;
        const cleanBorrowerName = loan.borrowerName?.trim().replace(/\s+/g, ' ') || 'अज्ञात';
        
        // PRECAUTION 5: Enhanced narration with complete closure information
        const narration = `कर्ज बंद - खाते क्र. ${loan.accountNumber} ${cleanBorrowerName}${groupDisplayName ? ` (${groupDisplayName})` : ''} - मुद्दल: ₹${principalAmount.toLocaleString('en-IN')} + व्याज: ₹${interestAmount.toLocaleString('en-IN')} - ${closureDate}`;
        
        await storage.createCashTransaction({
          tenantId: tenantId,
          transactionDate: closureDate,
          transactionType: 'cash_in',
          amount: expectedAmount,
          category: 'income',
          narration: narration,
          partyId: null,
          fromAccount: ACCOUNT_TYPES.CUSTOMER,
          toAccount: ACCOUNT_TYPES.CASH,
          loanId: loan.id // PRECAUTION: Link to loan for better tracking
        });

        console.log(`✅ COMPREHENSIVE CASH SYNC: Closure transaction created with maximum security for loan ${loan.accountNumber}:`, {
          amount: expectedAmount,
          date: closureDate,
          loanId: loan.id,
          securityLevel: 'comprehensive'
        });
      } else {
        console.log(`🚫 COMPREHENSIVE PRECAUTION: Closure duplicate prevented for loan ${loan.accountNumber}:`, {
          existingId: duplicateTransaction.id,
          existingAmount: duplicateTransaction.amount,
          existingNarration: duplicateTransaction.narration,
          preventionType: 'multi-pattern-verification',
          securityLevel: 'maximum'
        });
      }
    } catch (error) {
      console.error(`Failed to sync loan closure ${loanId}:`, error);
    }
  };

  const syncLoanReopen = async (loanId: string, tenantId: string) => {
    try {
      const loans = await storage.getLoans(tenantId);
      const loan = loans.find((l: any) => l.id === loanId);
      
      if (!loan) {
        console.error(`Loan ${loanId} not found for reopen sync`);
        return;
      }

      // Check if cash transaction for closure exists and delete it
      const cashTransactions = await storage.getCashTransactions(tenantId);
      const closureCashTx = cashTransactions.find((ct: any) => 
        ct.narration && (
          ct.narration.includes('कर्ज बंद') &&
          (ct.narration.includes(loan.accountNumber) || ct.narration.includes(loan.borrowerName))
        )
      );

      if (closureCashTx) {
        await storage.deleteCashTransaction(closureCashTx.id, tenantId);
        console.log(`Deleted closure cash transaction for reopened loan ${loan.accountNumber}`);
      }

      // Create new disbursement cash transaction for reopening
      if (Number(loan.principalAmount) > 0) {
        await storage.createCashTransaction({
          tenantId: tenantId,
          transactionDate: formatDateForDB(new Date().toISOString().split('T')[0]),
          transactionType: 'cash_out',
          amount: loan.principalAmount,
          category: 'expense',
          narration: `कर्ज पुनरोपन - खाते क्र. ${loan.accountNumber} ${loan.borrowerName} - मुद्दल: ₹${loan.principalAmount}`,
          partyId: null,
          fromAccount: ACCOUNT_TYPES.CASH,
          toAccount: ACCOUNT_TYPES.CUSTOMER
        });
        
        console.log(`Cash disbursement sync created for reopened loan ${loan.accountNumber}`);
      }
    } catch (error) {
      console.error(`Failed to sync loan reopening ${loanId}:`, error);
    }
  };

  const handleLoanDelete = async (loanId: string, tenantId: string) => {
    try {
      const loans = await storage.getLoans(tenantId);
      const loan = loans.find((l: any) => l.id === loanId);
      
      if (!loan) return;

      // Delete related cash transactions
      const cashTransactions = await storage.getCashTransactions(tenantId);
      const relatedCashTransactions = cashTransactions.filter((ct: any) => 
        ct.narration && (
          ct.narration.includes(loan.accountNumber) ||
          ct.narration.includes(loan.borrowerName)
        )
      );

      for (const ct of relatedCashTransactions) {
        await storage.deleteCashTransaction(ct.id, tenantId);
        console.log(`Deleted cash transaction ${ct.id} for deleted loan ${loan.accountNumber}`);
      }

      // Delete loan closures
      const closures = await storage.getLoanClosures(tenantId, loanId);
      for (const closure of closures) {
        await storage.deleteLoanClosure(closure.id, tenantId);
      }

    } catch (error) {
      console.error(`Failed to handle loan deletion ${loanId}:`, error);
    }
  };

  const handleCashTransactionDelete = async (transactionId: string, tenantId: string) => {
    try {
      const cashTransactions = await storage.getCashTransactions(tenantId);
      const transaction = cashTransactions.find((t: any) => t.id === transactionId);
      
      if (!transaction || !transaction.narration) return;

      // If deleting loan-related cash transaction, handle loan status
      if (transaction.narration.includes('कर्ज')) {
        const loans = await storage.getLoans(tenantId);
        
        // Find related loan
        const loan = loans.find((l: any) => 
          transaction.narration.includes(l.accountNumber) || 
          transaction.narration.includes(l.borrowerName)
        );

        if (loan) {
          // If deleting loan closure transaction, reopen the loan
          if (transaction.narration.includes('कर्ज बंद')) {
            await storage.updateLoan(loan.id, tenantId, { status: 'active' });
            
            // Delete any loan closure records
            const closures = await storage.getLoanClosures(tenantId, loan.id);
            for (const closure of closures) {
              await storage.deleteLoanClosure(closure.id, tenantId);
            }
            
            console.log(`Reopened loan ${loan.accountNumber} due to cash transaction deletion`);
          }
          
          // If deleting loan disbursement transaction, mark loan inactive
          if (transaction.narration.includes('कर्ज वितरण')) {
            // Check if there are any other cash transactions for this loan
            const otherTransactions = cashTransactions.filter((ct: any) => 
              ct.id !== transactionId &&
              ct.narration && (
                ct.narration.includes(loan.accountNumber) ||
                ct.narration.includes(loan.borrowerName)
              )
            );
            
            if (otherTransactions.length === 0) {
              await storage.updateLoan(loan.id, tenantId, { status: 'inactive' });
              console.log(`Marked loan ${loan.accountNumber} as inactive due to disbursement deletion`);
            }
          }
        }
      }
    } catch (error) {
      console.error(`Failed to handle cash transaction deletion ${transactionId}:`, error);
    }
  };

  const validateCashBalance = async (tenantId: string): Promise<boolean> => {
    try {
      const cashTransactions = await storage.getCashTransactions(tenantId);
      const loans = await storage.getLoans(tenantId);
      
      let calculatedBalance = 0;
      
      // Process cash transactions
      for (const ct of cashTransactions) {
        const amount = parseFloat(ct.amount || 0);
        if (ct.transactionType === 'cash_in') {
          calculatedBalance += amount;
        } else {
          calculatedBalance -= amount;
        }
      }
      
      // Process loans not covered by cash transactions
      for (const loan of loans) {
        // Check if loan has corresponding cash transactions
        const hasDisbursementTx = cashTransactions.some((ct: any) => 
          ct.narration && ct.narration.includes('कर्ज वितरण') && 
          (ct.narration.includes(loan.accountNumber) || ct.narration.includes(loan.borrowerName))
        );
        
        if (!hasDisbursementTx) {
          calculatedBalance -= parseFloat(loan.principalAmount || 0);
        }
        
        // Check for closures
        if (loan.status === 'closed') {
          const hasClosureTx = cashTransactions.some((ct: any) => 
            ct.narration && ct.narration.includes('कर्ज बंद') && 
            (ct.narration.includes(loan.accountNumber) || ct.narration.includes(loan.borrowerName))
          );
          
          if (!hasClosureTx) {
            const closures = await storage.getLoanClosures(tenantId, loan.id);
            if (closures.length > 0) {
              const totalRepayment = parseFloat(loan.principalAmount || 0) + parseFloat(closures[0].interestPaid || 0);
              calculatedBalance += totalRepayment;
            }
          }
        }
      }
      
      console.log(`Cash balance validation: ${calculatedBalance}`);
      return true;
      
    } catch (error) {
      console.error('Cash balance validation failed:', error);
      return false;
    }
  };

  const generateAccountingSummary = async (tenantId: string, dateFrom: string, dateTo: string) => {
    try {
      const cashTransactions = await storage.getCashTransactions(tenantId);
      const loans = await storage.getLoans(tenantId);
      
      const fromDate = new Date(dateFrom);
      const toDate = new Date(dateTo);
      
      const summary = {
        cashIn: 0,
        cashOut: 0,
        loansDisbursed: 0,
        loansRepaid: 0,
        netCashFlow: 0,
        openingBalance: 0,
        closingBalance: 0
      };
      
      // Calculate opening balance
      cashTransactions.forEach((ct: any) => {
        const txDate = new Date(ct.transactionDate);
        const amount = parseFloat(ct.amount || 0);
        
        if (txDate < fromDate) {
          if (ct.transactionType === 'cash_in') {
            summary.openingBalance += amount;
          } else {
            summary.openingBalance -= amount;
          }
        } else if (txDate >= fromDate && txDate <= toDate) {
          if (ct.transactionType === 'cash_in') {
            summary.cashIn += amount;
            if (ct.narration && ct.narration.includes('कर्ज बंद')) {
              summary.loansRepaid += amount;
            }
          } else {
            summary.cashOut += amount;
            if (ct.narration && ct.narration.includes('कर्ज वितरण')) {
              summary.loansDisbursed += amount;
            }
          }
        }
      });
      
      summary.netCashFlow = summary.cashIn - summary.cashOut;
      summary.closingBalance = summary.openingBalance + summary.netCashFlow;
      
      return summary;
      
    } catch (error) {
      console.error('Failed to generate accounting summary:', error);
      return null;
    }
  };

  const syncCashTransaction = async (transactionId: string, tenantId: string) => {
    // Implementation for syncing individual cash transactions
    await validateCashBalance(tenantId);
  };

  return {
    syncLoanDisbursement,
    syncLoanClosure,
    syncLoanReopen,
    syncCashTransaction,
    handleLoanDelete,
    handleCashTransactionDelete,
    validateCashBalance,
    generateAccountingSummary
  };
}